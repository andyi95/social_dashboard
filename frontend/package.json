{
  "name": "nuxt-app",
  "private": true,
  "version": "0.0.0",
  "author": "Andrey Chernikov",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "build:win": "electron-builder --win  --onSuccess run.electron"
  },
  "main": "main.ts",
  "build": {
    "appId": "{{ appId }}",
    "directories": {
      "buildResources": "static",
      "output": "build"
    }
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^2.0.0",
    "@electron-toolkit/utils": "^2.0.1",
    "@nuxt/devtools": "latest"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^8.0.0-rc.5",
    "@pinia/nuxt": "^0.4.11",
    "@vicons/carbon": "^0.12.0",
    "@vicons/fluent": "^0.12.0",
    "@vicons/ionicons5": "^0.12.0",
    "@vuepic/vue-datepicker": "^7.1.0",
    "axios": "^1.5.1",
    "core-js": "^3.32.2",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "echarts": "^5.4.3",
    "echarts-wordcloud": "^2.1.0",
    "less": "^4.2.0",
    "less-loader": "^11.1.3",
    "naive-ui": "^2.34.4",
    "nuxt": "^3.8.1",
    "pinia": "^2.1.6",
    "pinia-plugin-persistedstate": "^3.2.0",
    "postcss": "^8.4.31",
    "rxjs": "^7.8.1",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.2.2",
    "vue-echarts": "^6.6.1",
    "vuetify": "^3.4.3"
  }
}
